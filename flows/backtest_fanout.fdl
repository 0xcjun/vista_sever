version: v1
type: flow
name: backtest-fanout

# Input shape:
# {
#   "tenant": {...},
#   "strategy_tomls": [ArtifactRef, ...],
#   "mode": "research" | "realtime",
#   "data_mode": "total" | "train" | "valid",
#   "backtest_workers": 1,
#   "wbt": { "fee_rate": 0.0, "digits": 2, "n_jobs": 1 },
#   "research_data_uri": null              # 可选,生产 NAS 预置时不传
# }

steps:
  - type: foreach
    name: per_strategy
    iterationMapping:
      collection: $.strategy_tomls
      item:       $.toml
    maxConcurrency: 8
    steps:
      - type: task
        name: strategy_backtest
        resourceArn: "acs:fc:${vars.region}:${vars.accountId}:functions/strategy-backtest${vars.functionSuffix}"
        inputMappings:
          - target: tenant
            source: $.tenant
          - target: payload
            source: |
              {
                "strategy_toml_uri":  $.toml.oss_uri,
                "research_data_uri":  $.research_data_uri,
                "mode":               $.mode,
                "data_mode":          $.data_mode,
                "fee_rate":           $.wbt.fee_rate,
                "digits":             $.wbt.digits,
                "n_jobs":             $.wbt.n_jobs,
                "max_workers":        $.backtest_workers
              }
        retry:
          - errors: ["OSS_READ_FAIL", "OSS_WRITE_FAIL", "CLICKHOUSE_CONNECT"]
            intervalSeconds: 10
            maxAttempts: 3
          - errors: ["VISTA_LOGIC_ERROR"]
            maxAttempts: 0
        timeoutSeconds: 1800

  - type: succeed
    name: done
