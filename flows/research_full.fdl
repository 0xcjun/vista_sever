version: v1
type: flow
name: research-full

# research-pipeline 的 alias:plan → builder → detect → duplicate → evaluate → filter → backtest。
# 旧版本把 backtest 拆在 backtest-fanout 子流;当前版本 backtest 已整合进 research-pipeline。
# 本文件只保留给历史调用方兼容,内部完全委托给 research-pipeline。

steps:
  - type: flow
    name: run_pipeline
    flowName: research-pipeline${env.FC_SUFFIX|""}

  - type: succeed
    name: done
