# ── 阿里云 / OSS ─────────────────────────────────────────────────────────
OSS_REGION=cn-hangzhou
OSS_BUCKET=vista-fc-dev
# 生产留空使用 FC Role；本地用 minio 时必填
OSS_ENDPOINT=http://host.docker.internal:9000
OSS_ACCESS_KEY_ID=dev
OSS_ACCESS_KEY_SECRET=devdevdev

# ── NAS ──────────────────────────────────────────────────────────────────
NAS_CACHE_ROOT=/mnt/vista-cache

# ── ClickHouse ───────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://host.docker.internal:8123
CLICKHOUSE_USER=dev
CLICKHOUSE_PASS=dev

# ── LLM ──────────────────────────────────────────────────────────────────
# 仅 factor-plan / factor-builder 需要
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# ── 运行时 ───────────────────────────────────────────────────────────────
LOG_FORMAT=json
TZ=Asia/Shanghai

# ── 构建期（不进函数运行环境）──────────────────────────────────────────
# 私有 pip 源凭据；docker build 时通过 --secret 注入
# UV_INDEX_ZBCZSC_DEV_USERNAME=...
# UV_INDEX_ZBCZSC_DEV_PASSWORD=...
