# vista-fc 环境变量模板
# 本地开发用：cp .env.example .env.local 后按需编辑
# 线上部署用：字段由 CI/部署脚本从 secret store 导入，再通过 s.yaml 的 common-env 注入 FC
#
# 下面每项标注了 [哪些函数依赖它]；对应函数不被调用时可留空。

# ── 存储（所有函数必需） ──────────────────────────────────────────────
# 本地 MinIO 打开；线上 Aliyun OSS 保持 false / 不设
OSS_S3_COMPAT=true
OSS_REGION=us-east-1                    # MinIO 默认；线上用 cn-hangzhou
OSS_BUCKET=vista-fc-dev
OSS_ENDPOINT=http://host.docker.internal:9000   # 容器内访问宿主 MinIO；线上留空走 Aliyun 默认
OSS_ACCESS_KEY_ID=dev
OSS_ACCESS_KEY_SECRET=devdevdev

# ── NAS（所有函数必需；存 factor.duckdb / research 结果 / k 线缓存） ─
NAS_CACHE_ROOT=/mnt/vista-cache

# ── vista 因子库 ────────────────────────────────────────────────────
# 两种模式二选一：
#   (1) duckdb：小流量 / 单机；因子库文件落在 NAS（推荐默认）
#   (2) clickhouse：高并发 / 生产；需要 CLICKHOUSE_DSN
VISTA_DB_TYPE=duckdb
DUCKDB_PATH=/mnt/vista-cache/factor.duckdb
VISTA_RESEARCH_PATH=/mnt/vista-cache/research

# ClickHouse DSN 格式（仅 VISTA_DB_TYPE=clickhouse 时需要）：
# [factor-filter / strategy-backtest / 任何 vista factor_db 读写]
# CLICKHOUSE_DSN=clickhouse://user:pass@host:9000/factor_db

# ── LLM（factor-plan / factor-builder） ─────────────────────────────
# ANTHROPIC_API_KEY: 必需
# ANTHROPIC_BASE_URL: Anthropic 官方留空；走反代/兼容网关（如智谱 GLM）时填
# CLAUDE_MODEL: 显式指定模型名；留空走 vista 内置默认
# AGNO_MODEL: 仅 factor-builder 的 agno 模式用，优先级 > CLAUDE_MODEL
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=
AGNO_MODEL=

# ── czsc 数据 API ─────────────────────────────────────────────────────
# [factor-detect 真实数据分支 / strategy-backtest / vista-realtime]
# 未设置 + 调用到 vista.data.xy|strategy 会 assert 挂进程
CZSC_TOKEN=
CZSC_DATA_API=https://api.zbczsc.com

# ── 运行时 ───────────────────────────────────────────────────────────
LOG_FORMAT=json
TZ=Asia/Shanghai

# ── 构建期（不进容器运行环境，仅 docker build） ─────────────────────
# 私有 pip 源凭据；当前 zbczsc-dev 公开无需凭证，保留占位仅供上游变更后启用
# UV_INDEX_ZBCZSC_DEV_USERNAME=...
# UV_INDEX_ZBCZSC_DEV_PASSWORD=...

# ── 部署期本地 probe 脚本用（不进 FC 容器） ─────────────────────────
# tests/deploy_preflight/08_ch_probe.sh 会 curl 这三个做 CH HTTP 健康检查
# CLICKHOUSE_URL=http://host.docker.internal:8123
# CLICKHOUSE_USER=dev
# CLICKHOUSE_PASS=dev
